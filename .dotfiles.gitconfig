[core]
	repositoryformatversion = 0
	filemode = true
	bare = true
	excludesFile = ~/.dotfiles.gitignore
[remote "origin"]
	url = git@github.com:ehaynes99/dotfiles.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
[branch "display-edid-hpd"]
	remote = origin
	merge = refs/heads/display-edid-hpd
