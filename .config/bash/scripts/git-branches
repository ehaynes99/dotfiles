#!/usr/bin/env bash

# List all branches with fzf and switch to selected

git rev-parse || exit

if [ ! -e "./.git/refs/remotes/origin/HEAD" ]; then
	echo 'missing HEAD'
	git remote set-head origin --auto
fi

default=$(git get-default)

branches=$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/)

branch=$(
	echo "$branches" | fzf \
		--preview="git cherry -v $default {} | awk '{\$2=\"\"; print \$0}'" \
		--preview-label="git cherry -v $default" \
		--preview-window='45%,border-sharp' \
		--border=sharp \
		--bind='tab:up' \
		--bind='shift-tab:down' \
		--bind='ctrl-q:abort'
)

if [[ -z "$branch" ]]; then
	exit
fi

if [[ -n "$(git status --porcelain)" ]]; then
	echo "uncommitted changes, aborting"
	exit 1
fi

git co "$branch"
