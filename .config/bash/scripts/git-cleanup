#!/usr/bin/env bash

# Finds all branches that have been merged or deleted from remote

git rev-parse || exit

if ! git symbolic-ref -q refs/remotes/origin/HEAD >/dev/null; then
	echo 'missing HEAD'
	git remote set-head origin --auto
fi

# Only branches whose upstream is gone. Branches that were never pushed have no
# upstream at all, so they never show up here. Emits "branch<TAB>worktree",
# where worktree is empty unless the branch is checked out in one.
gone=$(git for-each-ref --sort=refname \
	--format='%(refname:short)	%(upstream:track)	%(worktreepath)' \
	refs/heads |
	awk -F'\t' '$2 == "[gone]" { print $1 "\t" $3 }')

default=$(git get-default)

# Empty unless herdr is installed, running, and has the worktree open.
herdr_workspace() {
	local path=$1
	command -v herdr >/dev/null 2>&1 || return 0
	command -v jq >/dev/null 2>&1 || return 0
	herdr worktree list --cwd "$path" 2>/dev/null |
		jq -r --arg path "$path" \
			'.result.worktrees[]? | select(.path == $path) | .open_workspace_id // empty' 2>/dev/null
}

if [[ -z "$gone" ]]; then
	echo 'No deleted branches exist.'
else
	to_delete=$(
		echo "$gone" | fzf \
			--multi \
			--preview="git cherry -v $default {1} | awk '{\$2=\"\"; print \$0}'" \
			--preview-label="git cherry -v $default" \
			--preview-window='45%,border-sharp' \
			--bind='ctrl-a:select-all' \
			--bind='ctrl-x:deselect-all' \
			--header '
CTRL-A to select all | CTRL-x to deselect all'
	)

	if [[ -n "$to_delete" ]]; then
		while IFS=$'\t' read -r branch worktree; do
			if [[ -n "$worktree" ]]; then
				# herdr holds the checkout open, so it has to let go of it first.
				# Its remove also deletes the checkout, leaving git nothing to do.
				workspace=$(herdr_workspace "$worktree")
				if [[ -n "$workspace" ]]; then
					# herdr keeps the checkout path from when the workspace was created
					# and doesn't follow a moved worktree, so its remove would target
					# the stale path. Close the workspace and let git remove it instead.
					checkout=$(herdr workspace get "$workspace" 2>/dev/null |
						jq -r '.result.workspace.worktree.checkout_path // empty' 2>/dev/null)
					if [[ "$checkout" == "$worktree" ]]; then
						herdr_cmd=(herdr worktree remove --workspace "$workspace")
					else
						herdr_cmd=(herdr workspace close "$workspace")
					fi
					if ! "${herdr_cmd[@]}" >/dev/null; then
						echo "skipping $branch: herdr could not remove workspace $workspace" >&2
						continue
					fi
				fi

				# Refuses on uncommitted changes, or if it is the current worktree.
				# Leave the branch alone in that case rather than forcing.
				if [[ -e "$worktree" ]] && ! git worktree remove "$worktree"; then
					echo "skipping $branch: could not remove worktree $worktree" >&2
					echo "  (use 'git worktree remove --force' if the changes are disposable)" >&2
					continue
				fi
			fi
			git branch -D "$branch"
		done <<<"$to_delete"
	fi
fi
