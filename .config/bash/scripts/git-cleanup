#!/usr/bin/env bash

# Finds branches that were merged or deleted from remote, or with --no-remote,
# branches that were never pushed at all.

git rev-parse || exit

# Both emit "branch<TAB>worktree", where worktree is empty unless the branch is
# checked out in one.

# Only branches whose upstream is gone. Branches that were never pushed have no
# upstream at all, so they never show up here.
gone_branches() {
	git for-each-ref --sort=refname \
		--format='%(refname:short)	%(upstream:track)	%(worktreepath)' \
		refs/heads |
		awk -F'\t' '$2 == "[gone]" { print $1 "\t" $3 }'
}

# A branch was never pushed if it has no upstream, or its upstream is another
# branch, e.g. a worktree branched with --track off origin/develop.
# %(upstream:track) is empty for an in-sync branch too, so it can't tell these
# apart.
unpushed_branches() {
	git for-each-ref --sort=refname \
		--format='%(refname:short)	%(upstream:lstrip=3)	%(worktreepath)' \
		refs/heads |
		awk -F'\t' '$2 != $1 { print $1 "\t" $3 }'
}

case ${1:-} in
	'')
		branches=$(gone_branches)
		none='No deleted branches exist.'
		;;
	--no-remote)
		branches=$(unpushed_branches)
		none='No unpushed branches exist.'
		;;
	*)
		echo 'usage: git-cleanup [--no-remote]' >&2
		exit 2
		;;
esac

default=$(git get-default)

if [[ -z "$branches" ]]; then
	echo "$none"
else
	to_delete=$(
		echo "$branches" | fzf \
			--multi \
			--preview="git cherry -v $default {1} | awk '{\$2=\"\"; print \$0}'" \
			--preview-label="git cherry -v $default" \
			--preview-window='45%,border-sharp' \
			--bind='ctrl-a:select-all' \
			--bind='ctrl-x:deselect-all' \
			--header '
CTRL-A to select all | CTRL-x to deselect all'
	)

	if [[ -n "$to_delete" ]]; then
		mapfile -t selected < <(cut -f1 <<<"$to_delete")
		git-remove-branch "${selected[@]}"
	else
		echo ""
		echo "$branches" | cut -f1
	fi
fi
