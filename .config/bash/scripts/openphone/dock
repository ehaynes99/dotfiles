#!/usr/bin/env bash

cd "$HOME/workspace/openphone/backend2/dev/start" || exit

ARGS=()

if [ "$1" = "nuke" ]; then
	read -p "Are you sure you want to NUKE EVERYTHING in docker???? " -n 1 -r
	echo
	if [[ $REPLY =~ ^[Yy]$ ]]; then
		# shellcheck disable=2046
		docker kill $(docker ps -q)
		docker system prune -af --volumes # aka --all --force --volumes
	fi
	exit
elif [ "$1" = "up" ]; then
	ARGS+=(up -d)
else
	ARGS+=("$1")
fi

if [ "$2" = "" ]; then
	ARGS+=(elasticsearch postgres mongo rabbit redis jaeger etcd)
fi

docker-compose "${ARGS[@]}" "${@:2}"
