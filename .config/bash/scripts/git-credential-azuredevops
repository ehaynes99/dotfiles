#!/usr/bin/env bash
# git credential helper for Azure DevOps, backed by the Azure CLI's login session.
#
# Install:
#   git config --global credential.https://<org>.visualstudio.com.helper azuredevops
#   git config --global credential.https://dev.azure.com.helper azuredevops
#
# Requires an active `az login`. Tokens are minted per invocation and not cached.

set -euo pipefail

# Fixed resource ID for Azure DevOps; identical across all tenants.
readonly AZURE_DEVOPS_RESOURCE_ID='499b84ac-1321-427f-aa17-267ca6975798'

# Only `get` is meaningful — there is nothing to store or erase.
[[ ${1-} == get ]] || exit 0

# Drain the key=value request on stdin so git doesn't see a broken pipe.
while IFS= read -r line && [[ -n $line ]]; do :; done

token=$(az account get-access-token \
  --resource "$AZURE_DEVOPS_RESOURCE_ID" \
  --query accessToken -o tsv)

# Azure DevOps ignores the username for token auth, but git requires a non-empty one.
printf 'username=azdo\n'
printf 'password=%s\n' "$token"
