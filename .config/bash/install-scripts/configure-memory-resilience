#!/usr/bin/env bash
set -euo pipefail

changed=()

put() {
	local path="$1" content="$2"
	if ! printf '%s\n' "$content" | sudo cmp -s - "$path" 2>/dev/null; then
		printf '%s\n' "$content" | sudo install -D -m644 /dev/stdin "$path"
		changed+=("$path")
		echo "wrote $path"
	fi
}

was_changed() {
	local p
	for p in "${changed[@]}"; do [ "$p" = "$1" ] && return 0; done
	return 1
}

put /etc/systemd/zram-generator.conf '[zram0]
compression-algorithm = zstd
zram-size = ram / 2'

put /etc/default/earlyoom "EARLYOOM_ARGS=\"-m 10 -s 100 -r 3600 -n --prefer '(^|/)tsc\$' --avoid '(^|/)(init|systemd.*|sshd|niri|ghostty|greetd|Xwayland|qs|dms)\$'\""

put /etc/sysctl.d/99-sysrq.conf 'kernel.sysrq = 244'

put /etc/default/atop 'LOGOPTS=""
LOGINTERVAL=60
LOGGENERATIONS=14
LOGPATH=/var/log/atop'

was_changed /etc/sysctl.d/99-sysrq.conf && sudo sysctl -q -p /etc/sysctl.d/99-sysrq.conf
was_changed /etc/default/earlyoom && sudo systemctl restart earlyoom
was_changed /etc/default/atop && sudo systemctl restart atop
was_changed /etc/systemd/zram-generator.conf && echo "reboot to resize zram"

for unit in earlyoom.service atop.service atop-rotate.timer; do
	if ! systemctl is-enabled --quiet "$unit" || ! systemctl is-active --quiet "$unit"; then
		sudo systemctl enable --now "$unit"
		changed+=("$unit")
	fi
done

[ "${#changed[@]}" -eq 0 ] && echo "memory resilience already configured"
exit 0
