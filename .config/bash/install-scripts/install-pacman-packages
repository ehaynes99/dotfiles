#!/usr/bin/env bash
set -euo pipefail

packages=(
	alacritty
	archlinux-keyring
	autoconf
	automake
	base
	bash-completion
	bat
	bat-extras
	blueman
	brave-bin
	btop
	cloc
	cmake
	consolas-font
	csvlens
	discord
	docker
	docker-buildx
	docker-compose
	dua-cli
	atop
	earlyoom
	expac
	fd
	feh
	firefox
	flameshot
	font-manager
	fzf
	gcc
	ghostty
	git
	github-cli
	gitui
	glibc
	greetd-dms-greeter-bin
	gnome-keyring
	gpicview
	hwinfo
	jq
	markdown2pdf
	mise
	neovim
	neovim-remote
	nerd-fonts-complete
	net-tools
	network-manager-applet
	networkmanager
	noto-fonts-cjk
	noto-fonts-emoji
	openssh
	pacman-contrib
	pdfarranger
	reflector
	ripgrep
	rsync
	slack-desktop
	speedtest-cli
	tealdeer
	terminus-font
	tree
	unzip
	vim
	wget
	wgetpaste
	wl-clipboard
	xdg-desktop-portal-gnome
	xdg-desktop-portal-wlr

	# thunar
	ffmpegthumbs
	gvfs
	thunar
	thunar-volman
	tumbler
)

if ! command -v paru &>/dev/null; then
	sudo pacman -S --needed --noconfirm base-devel rustup
	rustup default stable

	tmpdir="$(mktemp -d)"
	git clone https://aur.archlinux.org/paru.git "$tmpdir/paru"
	(cd "$tmpdir/paru" && makepkg -si --noconfirm)
	rm -rf "$tmpdir"
fi

missing=()
for pkg in "${packages[@]}"; do
	pacman -Qi "$pkg" &>/dev/null || missing+=("$pkg")
done

if [ "${#missing[@]}" -gt 0 ]; then
	paru -S --needed "${missing[@]}"
else
	echo "all packages already installed"
fi
