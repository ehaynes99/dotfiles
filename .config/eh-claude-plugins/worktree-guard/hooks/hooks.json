{
  "description": "Blocks `git worktree add` and points at worktree-create instead.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-worktree-add.sh"] }
        ]
      }
    ]
  }
}
