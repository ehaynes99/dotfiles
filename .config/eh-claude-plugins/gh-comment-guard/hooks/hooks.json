{
  "description": "Blocks posting GitHub PR/issue comments and reviews as the user.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/block-gh-comment.sh"] }
        ]
      }
    ]
  }
}
